  // Dedicated MIS collections. Other Learning Hub collections keep their existing rules.
  function misProfile() {
   return get(/databases/$(database)/documents/school_mis_incidents_v1_staff/$(request.auth.uid)).data;
  }
  function misStaff() { return request.auth != null && misProfile().active == true; }
  function misAdmin() { return misStaff() && misProfile().role == 'report-reviewer'; }
  function validMisIncident(d, id) {
   return d.keys().hasOnly(['id','studentId','involvedIds','studentIds','level','title','description','location','followup','date','time','teacherId','savedAt'])
    && d.keys().hasAll(['id','studentId','involvedIds','studentIds','level','title','description','location','followup','date','time','teacherId','savedAt'])
    && id.matches('[A-Za-z0-9_-]{8,100}') && d.id == id
    && d.studentId is string && d.involvedIds is list && d.studentIds is list
    && d.involvedIds.size() <= 100 && d.studentIds == [d.studentId].concat(d.involvedIds)
    && d.studentIds.toSet().size() == d.studentIds.size()
    && get(/databases/$(database)/documents/school_mis_incidents_v1_config/catalog).data.studentIds.hasAll(d.studentIds)
    && d.level in ['C1','C2','C3','R1','R2','R3']
    && d.title is string && d.title.size() > 0 && d.title.size() <= 120
    && d.description is string && d.description.size() > 0 && d.description.size() <= 3000
    && d.location is string && d.location.size() > 0 && d.location.size() <= 100
    && d.followup is string && d.followup.size() <= 2000
    && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
    && d.time is string && d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
    && d.teacherId == request.auth.uid && d.savedAt == request.time;
  }
  match /school_mis_incidents_v1_staff/{uid} {
   allow get: if misStaff() && (request.auth.uid == uid || misAdmin());
   allow list: if false;
   allow update: if misAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds'])
    && request.resource.data.studentIds is list
    && get(/databases/$(database)/documents/school_mis_incidents_v1_config/catalog).data.studentIds.hasAll(request.resource.data.studentIds);
   allow create, delete: if false;
  }
  match /school_mis_incidents_v1_config/{id} {
   allow get: if misStaff() && id in ['catalog','roles'];
   allow update: if misAdmin() && id == 'roles'
    && request.resource.data.keys().hasOnly(['revision','heads','tutors','updatedAt','updatedBy'])
    && request.resource.data.revision == resource.data.revision + 1
    && request.resource.data.heads is map && request.resource.data.tutors is map
    && request.resource.data.updatedBy == request.auth.uid;
   allow create, delete, list: if false;
  }
  match /school_mis_incidents_v1_records/{id} {
   allow read: if misStaff() && (misAdmin() || resource.data.teacherId == request.auth.uid
    || resource.data.studentIds.hasAny(misProfile().studentIds));
   allow create: if misStaff() && validMisIncident(request.resource.data, id);
   allow update, delete: if false;
  }
